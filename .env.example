# Copy this file to .env and fill it in. Never commit .env.

# Which niche pack to run (folder name under packs/)
DE_PACK=us-rise-and-fall

# Where projects, cache and the database live (default: ./workspace)
# DE_WORKSPACE=/path/to/workspace

# --- Claude --------------------------------------------------------------
# "api"         = Anthropic API key, billed per use (needed for a server)
# "claude-code" = runs through the `claude` CLI on your Claude Code plan
LLM_PROVIDER=api
ANTHROPIC_API_KEY=
MODEL_DEEP=claude-opus-5-5
MODEL_FAST=claude-sonnet-5-5
WEB_SEARCH=true
# Claude looks at candidate footage frames before a clip is used
VISION_FOOTAGE_CHECK=true

# --- Narration -----------------------------------------------------------
# "voicestudio" = free, local VoiceStudio app (github.com/debpalash/VoiceStudio)
# "elevenlabs"  = hosted ElevenLabs API, billed per character
TTS_PROVIDER=voicestudio

# VoiceStudio: the app must be open. VOICE is a voice profile name or ID
# made in the app (clone or design one), or "default".
VOICESTUDIO_URL=http://127.0.0.1:3900
VOICESTUDIO_VOICE=default
VOICESTUDIO_MODEL=omnivoice

# ElevenLabs (only when TTS_PROVIDER=elevenlabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- YouTube research (de trends) ----------------------------------------
# Free API key (Google Cloud console > APIs > YouTube Data API v3 > Credentials
# > API key). Read-only public data, no access to your channel. Leave empty to
# use yt-dlp instead (pip install yt-dlp).
YOUTUBE_API_KEY=

# Identify the tool politely to archive.org / Library of Congress
DE_USER_AGENT=documentary-engine/0.1 (personal research)
