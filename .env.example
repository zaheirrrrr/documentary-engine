# Copy this file to .env and fill it in. Never commit .env.

# Which niche pack to run (folder name under packs/)
DE_PACK=us-rise-and-fall

# Where projects, cache and the database live (default: ./workspace)
# DE_WORKSPACE=/path/to/workspace

# --- Claude --------------------------------------------------------------
# "api"         = Anthropic API key, billed per use (needed for a server)
# "claude-code" = runs through the `claude` CLI on your Claude Code plan
LLM_PROVIDER=api
ANTHROPIC_API_KEY=
MODEL_DEEP=claude-opus-5-5
MODEL_FAST=claude-sonnet-5-5
WEB_SEARCH=true
# Claude looks at candidate footage frames before a clip is used
VISION_FOOTAGE_CHECK=true

# --- ElevenLabs ----------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Identify the tool politely to archive.org / Library of Congress
DE_USER_AGENT=documentary-engine/0.1 (personal research)
